@model AvatarOptions
@{
    ViewData["Title"] = "Home Page";
}

<style>
    /* Ramen (.gameFrame), knapparna (.frameButton) och bakgrunden finns i site.css */
    /* Allt i en kolumn: gubben, skapa rum, gå med i rum, highscore */
    .homeFrame {
        gap: 12px;
    }

        .homeFrame h3 {
            font-size: 1.3rem;
            margin: 8px 0 0;
        }

        .homeFrame .lineInput {
            width: 260px;
            font-size: 1.1rem;
            padding-bottom: 2px;
        }

        /* Knapparna lika breda som textfälten */
        .homeFrame .frameButton {
            width: 260px;
            margin-bottom: 8px;
        }

    .homeDivider {
        width: 260px;
        border-top: 3px solid #990000;
        border-radius: 2px;
        margin: 4px 0;
    }

    /* Gubbväljaren: gubben i mitten, pilar på varje sida för varje plagg */
    .avatarPicker {
        position: relative;
        width: 330px;
    }

        .avatarPicker .avatar {
            width: 250px;
            margin: 0 auto;
        }

        .avatarPicker .arrow {
            position: absolute;
            width: 24px;
            height: 30px;
            padding: 0;
            border: none;
            background-color: #990000;
            cursor: pointer;
            transform: translateY(-50%);
        }

            .avatarPicker .arrow:hover {
                background-color: #4D0000;
            }

        .avatarPicker .arrow.left {
            left: 0;
            clip-path: polygon(100% 0, 0 50%, 100% 100%);
        }

        .avatarPicker .arrow.right {
            right: 0;
            clip-path: polygon(0 0, 100% 50%, 0 100%);
        }

    @@media (max-width: 380px) {
        .gameFrame {
            padding: 16px 8px;
        }

        .avatarPicker {
            width: 290px;
        }

            .avatarPicker .avatar {
                width: 220px;
            }
    }
</style>

<div class="gameFrame homeFrame">
    <h3>Välj din gubbe</h3>
    <div class="avatarPicker" id="avatarPicker">
        <partial name="_Avatar" model="new Avatar()" />
    </div>

    <div class="homeDivider"></div>

    <h3>Skapa rum</h3>
    <input id="createPlayerNameInput" class="lineInput" placeholder="Ditt namn" />
    <button id="createRoomBtn" class="frameButton">Skapa rum</button>

    <div class="homeDivider"></div>

    <h3>Gå med i rum</h3>
    <input id="roomCodeInput" class="lineInput" placeholder="Rumskod" />
    <input id="playerNameInput" class="lineInput" placeholder="Ditt namn" />
    <button id="joinRoomBtn" class="frameButton">Gå med</button>

    <div class="homeDivider"></div>

    <a class="frameButton" asp-controller="Home" asp-action="Highscore">Highscore</a>
</div>


<script>
    // ----- Gubbväljaren -----
    const avatarOptions = @Json.Serialize(Model);

    // Samma ordning som bilderna läggs på varandra. "top" är var pilarna sitter (i % av gubbens höjd).
    const avatarParts = [
        { key: "color", label: "kroppsfärg", top: 88 },
        { key: "clothes", label: "kläder", top: 70 },
        { key: "mouth", label: "mun", top: 43 },
        { key: "eyes", label: "ögon", top: 31 },
        { key: "hat", label: "hatt", top: 14 },
    ];

    // Börja med det som valdes senast i den här fliken, annars första alternativet
    let avatar = {};
    try { avatar = JSON.parse(sessionStorage.getItem("ritagissaAvatar")) || {}; } catch { }
    avatarParts.forEach(part => {
        const options = avatarOptions[part.key];
        if (!options.includes(avatar[part.key])) avatar[part.key] = options[0] ?? null;
    });

    const picker = document.getElementById("avatarPicker");
    const avatarBox = picker.querySelector(".avatar");
    avatarBox.innerHTML = "";

    avatarParts.forEach(part => {
        const img = document.createElement("img");
        img.alt = "";
        avatarBox.appendChild(img);
        part.img = img;

        // Bara plagg med fler än ett alternativ behöver pilar
        if (avatarOptions[part.key].length < 2) return;

        ["left", "right"].forEach(side => {
            const arrow = document.createElement("button");
            arrow.type = "button";
            arrow.className = `arrow ${side}`;
            arrow.setAttribute("aria-label", `${side === "left" ? "Föregående" : "Nästa"} ${part.label}`);
            // Pilarna sitter relativt gubben (väljaren är lika hög som gubben)
            arrow.style.top = `${part.top}%`;
            arrow.addEventListener("click", () => changePart(part, side === "left" ? -1 : 1));
            picker.appendChild(arrow);
        });
    });

    function changePart(part, step) {
        const options = avatarOptions[part.key];
        const index = options.indexOf(avatar[part.key]);
        avatar[part.key] = options[(index + step + options.length) % options.length];
        renderAvatar();
    }

    function renderAvatar() {
        avatarParts.forEach(part => {
            const name = avatar[part.key];
            part.img.style.display = name ? "" : "none";
            if (name) part.img.src = `/images/avatar/${name}.png`;
        });
        try { sessionStorage.setItem("ritagissaAvatar", JSON.stringify(avatar)); } catch { }
    }

    renderAvatar();
    // ----- slut på gubbväljaren -----

    document.getElementById("createRoomBtn").addEventListener("click", () => {
        const playerName = document.getElementById("createPlayerNameInput").value;
        const roomCode = Math.random().toString(36).substring(2, 7).toUpperCase();
        window.location.href = `/Home/Lobby?roomCode=${roomCode}&playerName=${encodeURIComponent(playerName)}&isHost=true`;
    });

    document.getElementById("joinRoomBtn").addEventListener("click", () => {
        const roomCode = document.getElementById("roomCodeInput").value;
        const playerName = document.getElementById("playerNameInput").value;
        window.location.href = `/Home/Lobby?roomCode=${roomCode}&playerName=${encodeURIComponent(playerName)}&isHost=false`;
    });
</script>


