@{
}
@{
    ViewData["Title"] = "Lobby";
}

<h2>Rum: <span id="roomCodeDisplay"></span></h2>

<h3>Spelare i rummet</h3>
<ul id="playerList"></ul>

<button id="startGameBtn" style="display:none;">Starta spel</button>

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script>
    const params = new URLSearchParams(window.location.search);
    const roomCode = params.get("roomCode");
    const playerName = params.get("playerName");
    const isHost = params.get("isHost") === "true";

    document.getElementById("roomCodeDisplay").textContent = roomCode;
    if (isHost) {
        document.getElementById("startGameBtn").style.display = "inline-block";
    }

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/gamehub")
        .build();

    connection.on("PlayerListUpdated", (playerNames) => {
        const list = document.getElementById("playerList");
        list.innerHTML = "";
        playerNames.forEach(name => {
            const li = document.createElement("li");
            li.textContent = name;
            list.appendChild(li);
        });
    });

    connection.on("JoinFailed", (reason) => {
        alert(reason);
        window.location.href = "/";
    });

    connection.start().then(() => {
        if (isHost) {
            connection.invoke("CreateRoom", roomCode, playerName);
        } else {
            connection.invoke("JoinRoom", roomCode, playerName);
        }
    });
</script>