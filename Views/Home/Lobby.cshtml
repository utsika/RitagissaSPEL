@{
}
@{
    ViewData["Title"] = "Lobby";
    ViewData["BackUrl"] = "/";   // tillbaka-pilen lämnar rummet, se .backArrow i scriptet
}

<style>
    #gameButton {
        width: 280px;
        padding: 12px 28px;
        margin-top: 5px;
        margin-bottom: 20px;
        border: none;
        border-radius: 10px;
        background-color: #990000;
        color: white;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.2s;
    }

        /* När muspekaren är över knappen */
        #gameButton:hover {
            background-color: #4D0000;
            transform: translateY(-1px);
            /* box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3); */
        }

        /* När man klickar */
        #gameButton:active {
            transform: translateY(0);
            box-shadow: none;
        }
    #wordButtons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px 56px;
        margin: 24px 0 40px;
    }

    /* Ramen (.gameFrame), knapparna (.frameButton) och bakgrunden finns i site.css */
    .gameFrame {
        min-height: 440px;
    }

        .gameFrame h3 {
            margin: auto 0 0;
        }

    .roundInfo {
        font-size: 0.8rem;
    }

    .timer {
        margin: 0 0 auto;
        font-size: 0.8rem;
    }

    /* Spelarens egen gubbe ovanför ramens högra hörn */
    #myAvatar {
        display: flex;
        justify-content: flex-end;
        align-items: flex-end;
        gap: 4px;
        max-width: 680px;
        height: 70px;
        margin: 20px auto 0;
        font-family: 'Madimi One', sans-serif;
        font-size: 1.1rem;
    }

        #myAvatar .avatar {
            width: 50px;
            margin-right: 16px;
        }


    /* ----- Ritvyn: chatt till vänster, canvas till höger ----- */
    #gamePanel.gameFrame {
        max-width: 900px;
    }

    .drawLayout {
        display: grid;
        grid-template-columns: 160px 1fr;
        grid-template-areas:
            "chat canvas"
            "chat info";
        gap: 4px 24px;
        width: 100%;
        margin-top: 12px;
        text-align: left;
    }

    .chat {
        grid-area: chat;
        display: flex;
        flex-direction: column;
        /* Lika hög som canvasen, längre chatt scrollar */
        height: 0;
        min-height: 100%;
        border-bottom: 3px solid #990000;
        border-radius: 0 0 2px 2px;
    }

        .chat h4 {
            font-family: inherit;
            font-size: 1rem;
            text-align: center;
            padding-bottom: 6px;
            margin: 0 0 8px;
            border-bottom: 3px solid #990000;
        }

    #guessLog {
        flex: 1;
        overflow-y: auto;
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.75rem;
    }

        #guessLog li {
            margin-bottom: 6px;
            overflow-wrap: anywhere;
        }

            #guessLog li.roundLine {
                margin-top: 10px;
                color: #990000;
                text-align: center;
            }

            #guessLog li.wordLine {
                margin-bottom: 14px;
                font-style: italic;
            }

    #drawCanvas {
        grid-area: canvas;
        display: block;
        width: 100%;
        height: auto;
        background: white;
        border: 3px solid #990000;
        border-radius: 8px;
        touch-action: none;
    }

    .drawInfo {
        grid-area: info;
        text-align: center;
        font-size: 0.8rem;
    }

        .drawInfo p {
            margin: 0;
        }

    #guessArea {
        margin-top: 12px;
        font-size: 1.1rem;
    }

        #guessInput {
            width: 180px;
            margin-left: 6px;
            padding: 0 4px;
            font-family: inherit;
            border: none;
            border-bottom: 2px solid black;
            outline: none;
            background: transparent;
        }

    /* Mobil: canvas överst, chatten under */
    @@media (max-width: 600px) {
        .gameFrame {
            padding: 16px;
        }

        .drawLayout {
            grid-template-columns: 1fr;
            grid-template-areas: "canvas" "info" "chat";
        }

        .chat {
            height: 160px;
            min-height: 0;
        }
    }

    /* Första spelaren hamnar i mitten och de nästa sprids utåt (justify-content: center) */
    #playerList {
        display: flex;
        justify-content: center;
        gap: 24px;
        width: 100%;
        list-style: none;
        padding: 0;
        margin: 36px 0;
    }

        #playerList li {
            flex: 0 1 90px;
            min-width: 0;
            font-size: 0.8rem;
        }

        #playerList .avatar {
            margin-bottom: 8px;
        }

        /* Fullt rum: spelarna fyller ut hela bredden */
        #playerList.full {
            justify-content: space-between;
            gap: 8px;
        }

    #lobbyStatus {
        margin: auto 0;
        font-size: 1.1rem;
    }

    #roundsSetting {
        margin: 8px 0 32px;
        font-size: 0.8rem;
    }

        /* Slidern: svart linje med röd prick */
        #roundsSlider {
            -webkit-appearance: none;
            appearance: none;
            display: block;
            width: 210px;
            height: 3px;
            margin-top: 18px;
            background: black;
            border-radius: 2px;
            cursor: pointer;
        }

            #roundsSlider::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                width: 16px;
                height: 16px;
                border-radius: 50%;
                background: #990000;
            }

            #roundsSlider::-moz-range-thumb {
                width: 16px;
                height: 16px;
                border: none;
                border-radius: 50%;
                background: #990000;
            }



    /* ----- Slutskärmen: prispall för topp tre ----- */
    .podium {
        display: flex;
        justify-content: center;
        align-items: flex-end;
        gap: 12px;
        width: 100%;
        margin: 28px 0 16px;
    }

    .podiumPlace {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 0 1 150px;
        min-width: 0;
    }

        /* Tvåan till vänster, ettan i mitten, trean till höger */
        .podiumPlace.pos1 { order: 2; }
        .podiumPlace.pos2 { order: 1; }
        .podiumPlace.pos3 { order: 3; }

        .podiumPlace .avatar {
            width: 90px;
        }

    .podiumName {
        max-width: 100%;
        margin-top: 4px;
        overflow-wrap: anywhere;
    }

    .podiumPoints {
        font-size: 0.8rem;
        margin-bottom: 6px;
    }

    /* Själva pallen. Höjden följer placeringen, så lika poäng ger lika höga block */
    .podiumStep {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 50px;
        font-size: 1.6rem;
        color: white;
        background: #990000;
        border-radius: 6px 6px 0 0;
    }

        .podiumPlace.rank1 .podiumStep { height: 110px; font-size: 2.4rem; }
        .podiumPlace.rank2 .podiumStep { height: 80px; font-size: 2rem; }

    /* Fyran och nedåt */
    #restList {
        list-style: none;
        padding: 0;
        margin: 0 0 16px;
        font-size: 0.9rem;
    }

    .gameOverButtons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 16px;
    }

    #waitForHostMsg {
        margin: 8px 0 0;
        font-size: 0.9rem;
    }
</style>

@* Spelarens egen gubbe, visas uppe till höger under spelets gång *@
<div id="myAvatar" style="visibility:hidden;">
    <span id="myName"></span>
    <div class="avatar"></div>
</div>

<div id="lobbyPanel" class="gameFrame">
    <partial name="_BackArrow" />
    <h2 class="roomCode"></h2>
    <ul id="playerList"></ul>

    <p id="lobbyStatus"></p>

    @* Värden väljer antal rundor, de andra ser bara värdet *@
    <div id="roundsSetting" style="display:none;">
        <label for="roundsSlider">Antal Rundor: <span id="roundsValue">2</span></label>
        <input type="range" id="roundsSlider" min="2" max="6" step="1" value="2" />
    </div>

    <button id="startGameBtn" class="frameButton" style="display:none;">Starta spel</button>
</div>

<div id="choosePanel" class="gameFrame" style="display:none;">
    <partial name="_BackArrow" />
    <h2 class="roomCode"></h2>
    <div class="roundInfo"></div>
    <h3>Välj ett ord :)</h3>
    <div id="wordButtons"></div>
    <p class="timer">Tid kvar: <span id="chooseTimer"></span> s</p>
</div>

<div id="waitPanel" class="gameFrame" style="display:none;">
    <partial name="_BackArrow" />
    <h2 class="roomCode"></h2>
    <div class="roundInfo"></div>
    <h3 id="waitText"></h3>
    <p class="timer" style="margin-top: 40px;">Tid kvar: <span id="waitTimer"></span> s</p>
</div>

<div id="gamePanel" class="gameFrame" style="display:none;">
    <partial name="_BackArrow" />
    <h2 class="roomCode"></h2>
    <div class="roundInfo"></div>

    <div class="drawLayout">
        <div class="chat">
            <h4>Chatt</h4>
            <ul id="guessLog"></ul>
        </div>

        <canvas id="drawCanvas" width="800" height="500"></canvas>

        <div class="drawInfo">
            <p id="gameInfo"></p>
            <p>Tid kvar: <span id="drawTimer"></span> s</p>
        </div>
    </div>

    <div id="guessArea" style="display:none;">
        <label for="guessInput">Gissa:</label>
        <input id="guessInput" autocomplete="off" autocapitalize="none" autocorrect="off" />
    </div>
</div>

@* NYTT: slutskärmen med ranking *@
<div id="gameOverPanel" class="gameFrame" style="display:none;">
    <partial name="_BackArrow" />
    <h2>Spelet är slut!</h2>

    <div id="podium" class="podium"></div>
    <ul id="restList"></ul>

    <p id="waitForHostMsg" style="display:none;">Väntar på att värden startar en ny omgång...</p>

    <div class="gameOverButtons">
        <button id="playAgainBtn" class="frameButton" style="display:none;">Spela igen</button>
        @* Öppnas i ny flik så man inte lämnar rummet *@
        <a class="frameButton" href="/Home/Highscore" target="_blank">Highscore</a>
        <button id="leaveBtn" class="frameButton">Lämna rummet</button>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script>
    const params = new URLSearchParams(window.location.search);
    const roomCode = params.get("roomCode");
    const playerName = params.get("playerName");
    const isHost = params.get("isHost") === "true";
    let playerId = sessionStorage.getItem("ritagissaPlayerId");
    if (!playerId) {
        playerId = crypto.randomUUID();
        sessionStorage.setItem("ritagissaPlayerId", playerId);
    }

    document.querySelectorAll(".roomCode").forEach(el => el.textContent = roomCode);
    document.getElementById("myName").textContent = playerName;
    if (isHost) {
        document.getElementById("startGameBtn").style.display = "inline-block";
        document.getElementById("roundsSetting").style.display = "block";
    }

    // NYTT: gameOverPanel tillagd i listan
    const panels = ["lobbyPanel", "choosePanel", "waitPanel", "gamePanel", "gameOverPanel"];
    function showPanel(name) {
        panels.forEach(p => {
            // Ramarna (.gameFrame) är flex-rutor, resten vanliga block
            const shown = document.getElementById(p).classList.contains("gameFrame") ? "flex" : "block";
            document.getElementById(p).style.display = (p === name) ? shown : "none";
        });
        // Egen gubbe syns bara när man spelar, inte i lobbyn
        const inGame = ["choosePanel", "waitPanel", "gamePanel"].includes(name);
        document.getElementById("myAvatar").style.visibility = inGame ? "visible" : "hidden";
    }

    let countdownInterval = null;
    function startCountdown(elementId, seconds) {
        clearInterval(countdownInterval);
        const el = document.getElementById(elementId);
        el.textContent = seconds;
        countdownInterval = setInterval(() => {
            seconds--;
            el.textContent = Math.max(seconds, 0);
            if (seconds <= 0) clearInterval(countdownInterval);
        }, 1000);
    }

    // ----- Canvas -----
    const canvas = document.getElementById("drawCanvas");
    const ctx = canvas.getContext("2d");
    ctx.lineWidth = 4;
    ctx.lineCap = "round";
    ctx.lineJoin = "round";
    ctx.strokeStyle = "black";

    let canDraw = false;
    let isDrawing = false;

    // Bygger en gubbe av bildlager (i rätt ordning från servern)
    function fillAvatar(avatarBox, layers) {
        avatarBox.innerHTML = "";
        layers.forEach(layer => {
            const img = document.createElement("img");
            img.src = `/images/avatar/${layer}.png`;
            img.alt = "";
            avatarBox.appendChild(img);
        });
    }

    function clearCanvas() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
    }

    function drawPoint(x, y, isNewStroke) {
        if (isNewStroke) {
            ctx.beginPath();
            ctx.moveTo(x, y);
        }
        ctx.lineTo(x, y);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(x, y);
    }

    function getPos(e) {
        const rect = canvas.getBoundingClientRect();
        return {
            x: Math.round((e.clientX - rect.left) * (canvas.width / rect.width)),
            y: Math.round((e.clientY - rect.top) * (canvas.height / rect.height))
        };
    }

    canvas.addEventListener("pointerdown", (e) => {
        if (!canDraw) return;
        isDrawing = true;
        canvas.setPointerCapture(e.pointerId);
        const { x, y } = getPos(e);
        drawPoint(x, y, true);
        connection.invoke("SendDrawPoint", roomCode, x, y, true).catch(err => console.error(err));
    });

    canvas.addEventListener("pointermove", (e) => {
        if (!canDraw || !isDrawing) return;
        const { x, y } = getPos(e);
        drawPoint(x, y, false);
        connection.invoke("SendDrawPoint", roomCode, x, y, false).catch(err => console.error(err));
    });

    canvas.addEventListener("pointerup", () => { isDrawing = false; });
    canvas.addEventListener("pointercancel", () => { isDrawing = false; });
    // ----- slut canvas -----

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/gamehub")
        .build();

    connection.on("PlayerListUpdated", (players, maxPlayers) => {
        const list = document.getElementById("playerList");
        list.innerHTML = "";
        players.forEach(player => {
            const li = document.createElement("li");

            const avatarBox = document.createElement("div");
            avatarBox.className = "avatar";
            fillAvatar(avatarBox, player.layers);

            const name = document.createElement("div");
            name.textContent = player.name;

            li.append(avatarBox, name);
            list.appendChild(li);
        });

        const isFull = players.length >= maxPlayers;
        list.classList.toggle("full", isFull);

        // Värden ser slider och startknapp istället för "Inväntar fler spelare..."
        const status = document.getElementById("lobbyStatus");
        status.textContent = isFull ? "Rummet är Fullt!" : (isHost ? "" : "Inväntar fler spelare...");
        status.style.display = status.textContent ? "block" : "none";
    });

    connection.on("YourAvatar", (layers) => {
        fillAvatar(document.querySelector("#myAvatar .avatar"), layers);
    });

    connection.on("JoinFailed", (reason) => {
        alert(reason);
        window.location.href = "/";
    });

    connection.on("GameError", (msg) => alert(msg));

    // NYTT: visar vilken runda det är
    // Chatten töms inte mellan turerna, så en rubrik visar när en ny runda börjar
    let lastLoggedRound = 0;
    connection.on("RoundUpdated", (current, total) => {
        document.querySelectorAll(".roundInfo").forEach(el => el.textContent = `Runda ${current} av ${total}`);
        if (current !== lastLoggedRound) {
            lastLoggedRound = current;
            addToGuessLog(`Runda ${current} av ${total}`, false, "roundLine");
        }
    });

    connection.on("ChooseWord", (words, seconds) => {
        const container = document.getElementById("wordButtons");
        container.innerHTML = "";

        words.forEach(word => {
            const btn = document.createElement("button");
            btn.className = "frameButton";
            btn.textContent = word;
            btn.addEventListener("click", () => {
                container.querySelectorAll("button").forEach(b => b.disabled = true);
                connection.invoke("SelectWord", roomCode, word).catch(err => console.error(err));
            });
            container.appendChild(btn);
        });

        showPanel("choosePanel");
        startCountdown("chooseTimer", seconds);
    });

    connection.on("WaitingForWord", (drawerName, seconds) => {
        document.getElementById("waitText").textContent =
            `Väntar på att ${drawerName} ska välja ett ord...`;
        showPanel("waitPanel");
        startCountdown("waitTimer", seconds);
    });

    connection.on("StartDrawing", (word) => {
        clearInterval(countdownInterval);
        document.getElementById("gameInfo").textContent = `Du ritar: ${word}`;
        clearCanvas();
        addToGuessLog(`${playerName} ritar!`, false);
        canDraw = true;
        document.getElementById("guessArea").style.display = "none";
        showPanel("gamePanel");
    });

    connection.on("StartGuessing", (drawerName, wordLength) => {
        clearInterval(countdownInterval);
        document.getElementById("gameInfo").textContent = `Ordet består av ${wordLength} bokstäver`;
        clearCanvas();
        addToGuessLog(`${drawerName} ritar!`, false);
        canDraw = false;
        document.getElementById("guessArea").style.display = "block";
        showPanel("gamePanel");
    });

    connection.on("ReceiveDrawPoint", (x, y, isNewStroke) => {
        drawPoint(x, y, isNewStroke);
    });

    connection.on("DrawTimerStarted", (seconds) => {
        startCountdown("drawTimer", seconds);
    });

    // ----- Gissningar -----
    function addToGuessLog(text, isCorrect, className) {
        const li = document.createElement("li");
        li.textContent = text;
        if (className) li.className = className;
        if (isCorrect) {
            li.style.color = "green";
            li.style.fontWeight = "bold";
        }
        const log = document.getElementById("guessLog");
        log.appendChild(li);
        log.scrollTop = log.scrollHeight;   // visa alltid senaste gissningen
    }

    function sendGuess() {
        const input = document.getElementById("guessInput");
        const text = input.value.trim();
        if (!text) return;
        connection.invoke("SendGuess", roomCode, text).catch(err => console.error(err));
        input.value = "";
        input.focus();
    }

    document.getElementById("guessInput").addEventListener("keydown", (e) => {
        if (e.key === "Enter") sendGuess();
    });

    connection.on("ReceiveGuess", (name, text) => {
        addToGuessLog(`${name} gissade: ${text}`, false);
    });

    connection.on("CorrectGuess", (name) => {
        addToGuessLog(`${name} gissade rätt!`, true);
    });

    connection.on("TurnEnded", (word, timedOut) => {
    clearInterval(countdownInterval);
    document.getElementById("drawTimer").textContent = "0";
    canDraw = false;
    isDrawing = false;
    document.getElementById("guessArea").style.display = "none";
    document.getElementById("gameInfo").textContent =
        timedOut ? `Tiden är slut! Ordet var: ${word}`
                 : `Turen är slut! Ordet var: ${word}`;
    addToGuessLog(`Ordet var: ${word}`, false, "wordLine");
});

    // ----- NYTT: spelet slut, spela igen eller lämna -----
    connection.on("GameOver", (ranking) => {
        clearInterval(countdownInterval);
        canDraw = false;
        isDrawing = false;

        // Topp tre på prispallen (ranking är redan sorterad, lika poäng har samma rank)
        const podium = document.getElementById("podium");
        podium.innerHTML = "";
        ranking.slice(0, 3).forEach((r, index) => {
            const place = document.createElement("div");
            place.className = `podiumPlace pos${index + 1} rank${r.rank}`;

            const avatarBox = document.createElement("div");
            avatarBox.className = "avatar";
            fillAvatar(avatarBox, r.layers);

            const name = document.createElement("div");
            name.className = "podiumName";
            name.textContent = r.name;

            const points = document.createElement("div");
            points.className = "podiumPoints";
            points.textContent = `${r.points} p`;

            const step = document.createElement("div");
            step.className = "podiumStep";
            step.textContent = r.rank;

            place.append(avatarBox, name, points, step);
            podium.appendChild(place);
        });

        // Resten som vanlig lista under pallen
        const rest = document.getElementById("restList");
        rest.innerHTML = "";
        ranking.slice(3).forEach(r => {
            const li = document.createElement("li");
            li.textContent = `${r.rank}. ${r.name} – ${r.points} p`;
            rest.appendChild(li);
        });

        document.getElementById("playAgainBtn").style.display = isHost ? "inline-block" : "none";
        document.getElementById("waitForHostMsg").style.display = isHost ? "none" : "block";
        showPanel("gameOverPanel");
    });

    connection.on("BackToLobby", () => {
        clearCanvas();
        document.getElementById("guessLog").innerHTML = "";   // nytt spel, ny chatt
        lastLoggedRound = 0;
        document.querySelectorAll(".roundInfo").forEach(el => el.textContent = "");
        showPanel("lobbyPanel");
    });

    connection.on("YouLeftRoom", () => {
        window.location.href = "/";
    });

    document.getElementById("playAgainBtn").addEventListener("click", () => {
        connection.invoke("PlayAgain", roomCode).catch(err => console.error(err));
    });

    document.getElementById("leaveBtn").addEventListener("click", () => {
        connection.invoke("LeaveRoom", roomCode, playerId).catch(err => console.error(err));
    });
    // ----- slut på det nya -----

    // Antal rundor: värden drar i slidern, servern skickar värdet till alla i rummet
    const roundsSlider = document.getElementById("roundsSlider");
    roundsSlider.addEventListener("input", () => {
        document.getElementById("roundsValue").textContent = roundsSlider.value;
    });
    roundsSlider.addEventListener("change", () => {
        connection.invoke("SetTotalRounds", roomCode, parseInt(roundsSlider.value)).catch(err => console.error(err));
    });

    connection.on("TotalRoundsUpdated", (rounds) => {
        roundsSlider.value = rounds;
        document.getElementById("roundsValue").textContent = rounds;
    });

    // Tillbaka-pilen (en i varje ram) lämnar rummet ordentligt istället för att bara byta sida
    document.querySelectorAll(".backArrow").forEach(arrow => arrow.addEventListener("click", (e) => {
        e.preventDefault();
        connection.invoke("LeaveRoom", roomCode, playerId)
            .catch(() => window.location.href = "/");   // inte uppkopplad, gå hem ändå
    }));

    document.getElementById("startGameBtn").addEventListener("click", () => {
        connection.invoke("StartGame", roomCode).catch(err => console.error(err));
    });

    // Gubben som valdes på startsidan (servern väljer standardplagg om den saknas)
    let avatar = null;
    try { avatar = JSON.parse(sessionStorage.getItem("ritagissaAvatar")); } catch { }

    connection.start().then(() => {
        if (isHost) {
            connection.invoke("CreateRoom", roomCode, playerName, playerId, avatar);
        } else {
            connection.invoke("JoinRoom", roomCode, playerName, playerId, avatar);
        }
    });
</script>