@model List<Ritagissa.Models.Winner>
@{
    ViewData["Title"] = "Highscore";
    ViewData["BackUrl"] = "/";
}

<style>
    /* Ramen (.gameFrame), knapparna (.frameButton) och bakgrunden finns i site.css */

    .highscoreTable {
        width: 100%;
        max-width: 480px;
        border-collapse: collapse;
        margin: 24px 0;
    }

        .highscoreTable th {
            padding: 8px 12px;
            font-weight: normal;
            border-bottom: 3px solid #990000;
        }

        .highscoreTable td {
            padding: 8px 12px;
            vertical-align: middle;
            border-bottom: 1px solid #eee;
        }

        .highscoreTable .avatar {
            width: 60px;
        }

        .highscoreTable td:last-child,
        .highscoreTable th:last-child {
            text-align: right;
        }

        /* Ettan får lite extra uppmärksamhet */
        .highscoreTable tr.first td {
            font-size: 1.2rem;
            color: #990000;
        }

</style>

<div class="gameFrame">
    <partial name="_BackArrow" />
    <h2>Highscore</h2>

    @if (Model.Count == 0)
    {
        <p style="margin: 40px 0;">Inga vinnare än – spela en omgång!</p>
    }
    else
    {
        <table class="highscoreTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th></th>
                    <th>Namn</th>
                    <th>Poäng</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr class="@(i == 0 ? "first" : "")">
                        <td>@(i + 1)</td>
                        <td>
                            <partial name="_Avatar" model="Model[i].Avatar" />
                        </td>
                        <td>@Model[i].Name</td>
                        <td>@Model[i].Points</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
